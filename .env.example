# ---- DefectDojo ----------------------------------------------------------
DD_PORT=8080
DEFECTDOJO_VERSION=latest
DD_ADMIN_USER=admin
DD_ADMIN_MAIL=admin@defectdojo.local
DD_ADMIN_PASSWORD=change-me-please
# generate with: openssl rand -base64 48 | tr -d '\n' | cut -c1-64
DD_SECRET_KEY=change-me-64-random-chars
# must be exactly 32 chars: openssl rand -base64 32 | tr -d '\n' | cut -c1-32
DD_CREDENTIAL_AES_256_KEY=change-me-32-random-chars-xxxxx
DD_DATABASE_USER=defectdojo
DD_DATABASE_PASSWORD=defectdojo
DD_DATABASE_NAME=defectdojo
DD_ALLOWED_HOSTS=*

# ---- Where findings land in DefectDojo -----------------------------------
DD_PRODUCT_NAME=my-app
DD_PRODUCT_TYPE_NAME=Research and Development
DD_MINIMUM_SEVERITY=Info

# ---- SAST (Semgrep) ------------------------------------------------------
# absolute path of the source tree to scan
SCAN_PATH=/data/ai-playground/repos/local-talking-llm
# rule set: p/default, p/security-audit, p/owasp-top-ten, auto, or a local path under SCAN_PATH
SEMGREP_CONFIG=p/default
SEMGREP_VERSION=latest

# ---- SCA / IaC / secrets (Trivy) -----------------------------------------
# Filesystem scan of SCAN_PATH: dependency CVEs, IaC misconfig, hardcoded secrets.
TRIVY_VERSION=latest
TRIVY_SCANNERS=vuln,misconfig,secret

# ---- SonarQube / SonarCloud import ---------------------------------------
# Pulls issues + security hotspots from an EXISTING Sonar analysis (Sonar does the
# scanning in your CI). Needs a read token. Imports the SONAR_BRANCH main branch;
# set SONAR_PR to a PR number instead to test the pipe against a pull request.
SONAR_URL=https://sonarcloud.io
SONAR_TOKEN=
SONAR_ORG=
SONAR_PROJECT_KEY=
SONAR_BRANCH=develop
SONAR_PR=

# ---- DAST (OWASP ZAP) ----------------------------------------------------
# URL of the running app. From inside docker, your host is http://host.docker.internal:PORT
# (Linux: add `extra_hosts: ["host.docker.internal:host-gateway"]` to the zap services, or use the LAN IP)
ZAP_TARGET=http://example.com
ZAP_VERSION=latest
# e.g. "-j" to enable AJAX spider, "-m 5" for max 5 min spidering
ZAP_EXTRA_ARGS=
# Authenticated scans: ZAP adds this header to every request to ZAP_AUTH_HEADER_SITE.
# Handy for bearer-token / SSO-protected apps (e.g. Entra ID). Leave the VALUE empty to
# scan unauthenticated. The header value is a secret — keep it in .env, never commit it.
ZAP_AUTH_HEADER=Authorization
ZAP_AUTH_HEADER_VALUE=
ZAP_AUTH_HEADER_SITE=
# OpenAPI/Swagger definition for the API scan (import-zap-api). Local file under ./reports
# or a URL. The API scan probes every operation once; use SAST/baseline first on shared envs.
ZAP_API_DEFINITION=
ZAP_API_FORMAT=openapi
